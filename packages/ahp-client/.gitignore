# Local upstream checkouts used for research and codegen. Never committed —
# the pinned upstream revision lives in UPSTREAM.md, and the vendoring script
# reproduces this directory.
/.research/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Both of these also self-ignore with a nested .gitignore, which fools git and
# nothing else -- hatchling's sdist selection reads only this file, and the
# sdist shipped both caches before they were named here.
.hypothesis/
.import_linter_cache/
.coverage
htmlcov/

# Node (dev-only: the conformance counterparty runs the real TypeScript client)
node_modules/
package-lock.json

# Editors / OS
# Local workspace settings: these accumulate live connection tokens once you
# point VS Code at a running host. The example lives in the README instead.
.vscode/
.DS_Store
.idea/
*.swp
